{
  "pixel-office-tracker": {
    "enabled": true,
    "SessionStart": [
      {
        "type": "command",
        "command": "node src/hook.mjs",
        "timeout": 5
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "node src/hook.mjs",
        "timeout": 5
      }
    ],
    "PostInvocation": [
      {
        "type": "command",
        "command": "node src/hook.mjs",
        "timeout": 5
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node src/hook.mjs",
        "timeout": 5
      }
    ],
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node src/hook.mjs",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node src/hook.mjs",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
